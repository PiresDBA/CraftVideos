# -----------------------------------------------------------------
# CHAVES E SEGREDOS — nunca entram no repositorio
# -----------------------------------------------------------------
.env
.env.*
*.env
secrets.json
secrets.yaml
secrets.yml
*credentials*.json
*.key
*.pem
*.pfx
*.p12
*.keystore

# -----------------------------------------------------------------
# FICHEIROS GERADOS — regeneraveis, nao se versionam
# -----------------------------------------------------------------
# work/ — pesado. Versionam-se apenas os PROGRAMAS e os PLANOS:
# o resto (renders, audio, frames, catalogos) e' gerado e reconstrói-se.
work/*
!work/clone-tooling/
work/clone-tooling/*
!work/clone-tooling/*.mjs
!work/explainer-study/
work/explainer-study/*
!work/explainer-study/preview/
work/explainer-study/preview/*
!work/explainer-study/preview/index.html
!work/explainer-study/preview/serve.mjs
!work/clones/
work/clones/*
!work/clones/*/
work/clones/*/*
# o PLANO e' decisao de trabalho: versiona-se (comentario numa linha propria,
# porque o git ignora o resto da linha quando o padrao tem texto a seguir)
!work/clones/*/plan-remotion.json
# o CONTRATO DE DIRECAO tambem e' decisao de trabalho: o ficheiro editorial
# (o que o operador escreve a mao, beat a beat) e o plano ja enriquecido.
!work/clones/*/direcao-editorial.json
!work/clones/*/plan-direcao.json
# as BASES v2 de avatar sao geradas (PNG), mas os programas/JSON que as
# produzem e validam sao decisao de trabalho: versionam-se. Os PNG ja estao
# ignorados globalmente por work/* e *.png.
!work/avatars/
!work/avatars/v2/
work/avatars/v2/*
!work/avatars/v2/*.mjs
!work/avatars/v2/*.py
!work/avatars/v2/*.json
work/avatars/v2/*.png
!work/avatars/v3/
work/avatars/v3/*
!work/avatars/v3/*.py
!work/avatars/v3/*.md
work/avatars/v3/__pycache__/
!work/avatars/frida.json
!work/avatars/luna.json
work/avatars/*.png
work/avatars/*.mp4
backups/
*.mp4
*.webm
*.png
*.jpg
*.jpeg
*.wav
*.mp3
*.ass
*.srt
*.log
*.tmp
temp/

# catalogos de comandos (dumpados por `artcraft.mjs refresh`)
.artcraft/reference/

# debris de diagnostico (diffs e capturas de teste)
.artcraft/clone/_*

# catalogo gerado do studio
studio.catalog.json

# backups intermedios da refatoração (ficam no disco, fora do git).
# A cópia do ficheiro CORROMPIDO (.corrupt-*.bak) mantem-se versionada:
# e' a prova do incidente e e' pequena.
*.prerefactor-*.bak

# -----------------------------------------------------------------
# APLICACOES E MOTORES INSTALADOS — nao fazem parte do codigo
# -----------------------------------------------------------------
AniCraft/
VectorCraft/
FilmCraft/
EffectCraft/
FigCraft/
Craft Anything/
Comfy/
OpenMontage/
VoiceCraft/
SoundCraft/
tools/
node_modules/
