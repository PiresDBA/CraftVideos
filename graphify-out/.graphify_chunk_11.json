{
  "nodes": [
    {"id": "work_frida_luna_agentes", "label": "Agentes — Frida & Luna (cadeia OpenBot recriada)", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_agentes_regras_de_ouro", "label": "Regras de ouro (8) da cadeia Frida & Luna", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Substituem o OpenBot travado e impedem deriva de estilo: manual no topo de cada ficheiro, nomes descritivos, proibição de useFrame() do R3F, suíte Craft local antes de código redundante, fila de VRAM na GTX 1060, personagem final só a partir das folhas aprovadas, comparação com o canal original e proibição de inventar CTR."},
    {"id": "work_frida_luna_agentes_cadeia_7_agentes", "label": "Elenco de 7 agentes (Curador-Prompts a Artista-desenho)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_agentes_curador_prompts", "label": "Agente Curador-Prompts", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traduz as 44 frases em 44 especificações de plano (enquadramento, luz, movimento, ritmo) a partir de tools/opus5-reference e templates OpenMontage/FilmCraft."},
    {"id": "work_frida_luna_agentes_diretor_arte", "label": "Agente Diretor-Arte", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arquiteta o roteiro em <Sequence> Remotion, fixa FPS/frames/paleta e escreve a bíblia de estilo; escolheu 2D à mão com textura de lápis (woojinrad-455731) e rejeitou o SVG gerado."},
    {"id": "work_frida_luna_agentes_especialista_comfyui", "label": "Agente Especialista-ComfyUI", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Só produz fundos/texturas para a GTX 1060; a LoRA childrens-picture-book-sd15 foi reprovada para personagem e a fila é sequencial para caber nos 6 GB de VRAM."},
    {"id": "work_frida_luna_agentes_especialista_audio_e_avatar", "label": "Agente Especialista-Áudio e Avatar", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separa voz/trilha do áudio original, mapeia tempos e planeia lip-sync por RMS — o avatar neuronal Wav2Lip com rosto placeholder foi abandonado por não haver rosto real a animar."},
    {"id": "work_frida_luna_agentes_dev_3d_craft", "label": "Agente Dev-3D-Craft", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Propôs 2.5D (PNG com alfa + fundo em camadas com parallax) em vez de 3D real, mantendo o look de livro infantil desenhado."},
    {"id": "work_frida_luna_agentes_dev_motion_qa", "label": "Agente Dev-Motion-QA", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_agentes_artista_desenho", "label": "Agente Artista-desenho", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O SVG/GIF geométrico foi reprovado pelo utilizador; o papel passou a fatiar as folhas aprovadas em sprites, recortar fundo e montar pose-sheet."},
    {"id": "work_frida_luna_agentes_clonar_estrutura_nunca_conteudo", "label": "Decisão herdada: clonar estrutura, nunca conteúdo", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\AGENTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copiar a montagem/paleta do canal sem reaproveitar o conteúdo alheio; áudio fixado a −14 LUFS / pico −1,5 dB e cache por hash da cena para re-render só do que mudou."},

    {"id": "work_frida_luna_personagens", "label": "Personagens — ficha técnica aprovada 2026-11-17", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\PERSONAGENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_personagens_proporcao_frida_luna", "label": "Proporção Frida:Luna (1,00 : 0,50)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\PERSONAGENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frida tem o dobro da massa (20 kg vs 10 kg) e da altura no quadro; a Luna ganha em comprimento, nunca em altura, e ambas ancoram os pés na mesma linha de base para a leitura infantil ser estável."},
    {"id": "work_frida_luna_personagens_frida_buldogue", "label": "Frida — buldogue inglês de pé, colar de pérolas", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\PERSONAGENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_personagens_luna_salsicha", "label": "Luna — salsicha (dachshund) de pé, bandana roxa", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\PERSONAGENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_personagens_metodo_corpo_da_folha_aprovada", "label": "Método: corpo é sempre o pixel da folha aprovada, só a cara muda", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\PERSONAGENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As grelhas de expressão geradas de raiz saíam com corpo, olho e traço diferentes em cada célula porque cada pose era gerada independentemente; reutilizar o corpo torna a consistência estrutural em vez de sorte."},
    {"id": "work_frida_luna_personagens_identidade_visual_fixa", "label": "Identidade visual fixa (pelagem, marca, olhos, contorno 6 px, fundo #F4E9D8)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\PERSONAGENS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},

    {"id": "work_frida_luna_style_bible", "label": "Bíblia de estilo — O Parque dos Pets (Frida & Luna)", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_style_bible_paleta_seis_cores", "label": "Paleta de seis cores fixas + três acentos", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sondagem k-means em CIELAB de 12 frames mostrou que 96,9% dos pixéis saturados caem em 0°–60° de matiz — o original já é uma paleta quente de 6 famílias, logo não se inventa cor nova: reescreve-se o objecto em ambar-petisco ou verde-parque."},
    {"id": "work_frida_luna_style_bible_temperatura_por_cena", "label": "Temperatura de luz por cena (11 valores, curva dia→noite)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As 11 cenas distinguem-se por luz (multiplicação de temperatura só no fundo) e não por matiz, o que impede o arco-íris de paleta e mantém as personagens com cor local."},
    {"id": "work_frida_luna_style_bible_banda_dos_apresentadores_714", "label": "Banda dos apresentadores em y=771 (0,714 da altura)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "presenterBandStart = 0.714 medido em ref/anatomy.json manda no layout: é a fronteira entre 'mundo' e 'palco', e nenhum elemento de primeiro plano começa acima dela."},
    {"id": "work_frida_luna_style_bible_regra_do_contorno", "label": "Regra do contorno (9/5/7 px, #2A1A12, tremor de mão ±1,5 px)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linhas perfeitamente rectas e paralelas leem-se como SVG, que foi reprovado; o tremor e a espessura variável (0,85×–1,15×) são o que faz o desenho parecer feito a lápis grosso."},
    {"id": "work_frida_luna_style_bible_proibicao_use_frame", "label": "Proibição de useFrame()/spring()/CSS keyframes — só useCurrentFrame + interpolate", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O render headless não espera por relógios de GPU ou CSS: animação indexada ao frame garante que o mesmo frame dá sempre o mesmo pixel e que o render por cenas isoladas fecha."},
    {"id": "work_frida_luna_style_bible_tipografia_familia", "label": "Tipografia: Fraunces (título), Baloo 2 (voz), Nunito (legenda/selo)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serifa arredondada macia e humanistas arredondadas aguentam contorno grosso e leem-se a 46 px; Arial/Inter/Roboto/Montserrat estão proibidas por terem 'cheiro de gerado por IA'."},
    {"id": "work_frida_luna_style_bible_camadas_ordem_obrigatoria", "label": "Ordem obrigatória de 6 camadas (fundo → grão/vinheta)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sequence-plan.json codifica layers[] e build_sequence_plan.py falha se a ordem for violada; multiply é proibido nas personagens porque perde o creme e só é permitido no grão/vinheta."},
    {"id": "work_frida_luna_style_bible_formato_9_16", "label": "Formato 9:16 com a mesma timeline (5 882 frames)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Um plano → três formatos: no vertical as personagens empilham-se (Frida em cima) e só muda o <AbsoluteFill> de composição, mantendo os mesmos from/durationInFrames."},
    {"id": "work_frida_luna_style_bible_transicoes_dentro_da_duracao", "label": "Transições dentro da duração (efeitos locais 5+5 frames)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As 11 sequências são contíguas e a soma tem de dar 5 882 exactos; uma transição sobreposta obrigaria a encurtar durationInFrames, por isso cada transição cai metade no fim da cena anterior e metade no início da seguinte."},
    {"id": "work_frida_luna_style_bible_portoes_de_qa", "label": "Oito portões de QA (grep useFrame, soma 5 882, paleta, contact sheet, LUFS)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\STYLE-BIBLE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},

    {"id": "work_frida_luna_beat_sheet", "label": "Beat sheet — 44 frases em 11 cenas (196,1 s)", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\BEAT-SHEET.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_beat_sheet_11_cenas", "label": "As 11 cenas (hook → final)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\BEAT-SHEET.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_beat_sheet_44_frases", "label": "44 frases com tempos, falante, expressões e acção", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\BEAT-SHEET.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "É a fonte única de tempos (beats.json): a especificação de planos lê daqui sem reescrever, e o áudio original é reaproveitado intacto."},

    {"id": "work_frida_luna_espec_planos", "label": "Especificação de planos — 44 planos / 196,069 s", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\espec-planos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_espec_planos_44_planos", "label": "44 planos com x/h em px, olhar, luz e câmara", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\espec-planos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O original tem 0,3 cortes/min; esta versão tem 13,5 planos/min para segurar a atenção infantil, e cada plano cobre também o silêncio até ao beat seguinte para a timeline fechar sem buracos em 196,069 s."},
    {"id": "work_frida_luna_espec_planos_planos_hero", "label": "Nove planos hero", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\espec-planos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "São as imagens-promessa (miniatura, primeiro abraço, pico de adrenalina, gag da melancia, beijo final); não levam texto nem corte interno e são os primeiros a renderizar, com motion blur de 2 amostras."},
    {"id": "work_frida_luna_espec_planos_regras_de_continuidade", "label": "Nove regras de continuidade (eixo, escala, zona segura, luz, câmara, olhar, silêncios)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\espec-planos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nenhum dos 16 saltos de escala ≥1,6× ocorre dentro do mesmo tamanho de plano e o eixo Frida-esquerda / Luna-direita nunca se cruza, porque a criança ancora a leitura por posição."},
    {"id": "work_frida_luna_espec_planos_fidelidade_ao_original", "label": "Fidelidade ao original: copiar elenco e paleta, mudar montagem e luz", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\espec-planos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copiar os 2 planos de câmara parada do original seria copiar o defeito; o pôr-do-sol e a noite (planos 36–44) são divergência assumida, declarada para poder ser revertida numa linha."},
    {"id": "work_frida_luna_espec_planos_build_espec_planos_mjs", "label": "build_espec_planos.mjs (gera .md + .json)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\espec-planos.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O .md e o .json saem do mesmo script para não divergirem; regenera-se depois de mexer em beats.json."},

    {"id": "work_frida_luna_audio_plano_lipsync", "label": "Plano de lip-sync por RMS", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_audio_plano_lipsync_rms_por_energia", "label": "Método RMS por energia (não Wav2Lip nem LivePortrait)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Não existe vídeo de rosto: as personagens são desenho 2D com boca em camada separada, e um avatar neuronal inventaria píxeis fotorrealistas que num contorno grosso aparecem como borrão, além de ocupar 4–6 GB de VRAM."},
    {"id": "work_frida_luna_audio_plano_lipsync_janela_40ms", "label": "Janela de análise 40 ms (1 764 amostras), passo 1 frame", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uma janela de 33 ms apanha 1 em cada 6 frames com energia quase nula a meio de uma vogal; 40 ms sobrepõe-se ao frame seguinte e suaviza o jitter já na origem."},
    {"id": "work_frida_luna_audio_plano_lipsync_tres_niveis_de_boca", "label": "Três níveis de boca (fechada / meia / aberta)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As folhas só têm dois desenhos de boca e o nível 1 sai de boca-2 com scaleY 0,55; um quarto nível exigiria redesenhar 13 poses × 2 personagens e não se lê a 640×360 no original."},
    {"id": "work_frida_luna_audio_plano_lipsync_histerese", "label": "Histerese ±0,06 e permanência mínima de 2 frames", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sem histerese a boca vibra nos 1,6% de frames de pausa com resíduo de música e nos 39,5% de frames dentro de palavra onde o RMS cai; é mais barato e previsível que aumentar a janela."},
    {"id": "work_frida_luna_audio_plano_lipsync_regra_da_palavra", "label": "Regra das 451 palavras (força nível ≥1 no miolo da palavra)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Com o gate simples a boca fechava a meio de sílabas tónicas; a regra garante boca fechada só entre palavras."},
    {"id": "work_frida_luna_audio_plano_lipsync_quem_fala_437_frames", "label": "Só 5 segmentos / 437 frames (7,4%) têm boca animada", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Os outros 39 segmentos são narrador; pôr as cadelas a morder o ar durante a narração produz o efeito de dobragem dessincronizada, o defeito mais visível em vídeos infantis clonados."},
    {"id": "work_frida_luna_audio_plano_lipsync_demucs_stem_de_voz", "label": "Sinal vem de audio/voz.wav (Demucs), contraste 16,6 dB", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\PLANO-LIPSYNC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O stem de voz tem contraste fala/pausa de 16,6 dB contra 5,45 dB da mistura, o que evita que a música abra a boca nas pausas."},

    {"id": "work_frida_luna_audio_relatorio_stems", "label": "Relatório de stems — O Parque dos Pets", "file_type": "document", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\RELATORIO-stems.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "work_frida_luna_audio_relatorio_stems_separacao_demucs_htdemucs", "label": "Separação real por Demucs 4.1.0 (htdemucs)", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\RELATORIO-stems.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separador estatístico corre em GPU com 1 job para caber nos 6 GB; não reconstrói a mistura ao bit (erro RMS 0,001969), logo os stems servem para decidir movimento e não para substituir ref/audio.wav."},
    {"id": "work_frida_luna_audio_relatorio_stems_contraste_fala_pausa_16_6_db", "label": "Ganho de contraste fala/pausa de 11,15 dB", "file_type": "concept", "source_file": "D:\\CRAFT\\work\\frida-luna\\audio\\RELATORIO-stems.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se o contraste do stem for alto, a música deixa de abrir a boca nas pausas — é o número que valida a separação para o lip-sync."}
